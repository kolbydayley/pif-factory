{
  "$id": "tech_discourse_v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "content_item_id",
    "content_span_id",
    "source_content_type",
    "extraction_status",
    "discourse_events",
    "concept_candidates",
    "rejected_candidates",
    "no_signal_reason",
    "overall_confidence",
    "needs_review",
    "review_reason"
  ],
  "properties": {
    "schema_version": {"type": "string", "enum": ["tech_discourse_v1"]},
    "content_item_id": {"type": "string"},
    "content_span_id": {"type": "string"},
    "source_content_type": {"type": "string"},
    "extraction_status": {"type": "string", "enum": ["coded", "no_signal", "insufficient_evidence", "low_signal", "excluded_source_context"]},
    "discourse_events": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "event_type",
          "actor_name",
          "actor_type",
          "actor_affiliation",
          "target_concept",
          "surface_terms",
          "stance",
          "claim_text",
          "claim_type",
          "certainty",
          "temporal_horizon",
          "frame",
          "causal_mechanism",
          "counterclaim",
          "model_names",
          "product_names",
          "organizations",
          "people",
          "why_it_matters",
          "evidence",
          "evidence_start",
          "evidence_end",
          "confidence"
        ],
        "properties": {
          "event_type": {"type": "string", "enum": ["term_usage", "frame_usage", "stance_position", "forecast", "causal_mechanism", "capability_claim", "product_signal", "market_signal", "risk_signal", "counterclaim", "uncertainty", "adoption_signal", "actor_mention", "entity_reference", "benchmark_signal", "technical_mechanism"]},
          "actor_name": {"type": ["string", "null"]},
          "actor_type": {"type": "string", "enum": ["person", "organization", "host", "guest", "author", "publication", "unknown"]},
          "actor_affiliation": {"type": ["string", "null"]},
          "target_concept": {"type": "string"},
          "surface_terms": {"type": "array", "items": {"type": "string"}},
          "stance": {"type": "string", "enum": ["positive", "negative", "mixed", "neutral", "uncertain", "not_applicable"]},
          "claim_text": {"type": "string"},
          "claim_type": {"type": "string"},
          "certainty": {"type": "string", "enum": ["high", "medium", "low", "speculative", "not_applicable"]},
          "temporal_horizon": {"type": ["string", "null"]},
          "frame": {"type": ["string", "null"]},
          "causal_mechanism": {"type": ["string", "null"]},
          "counterclaim": {"type": ["string", "null"]},
          "model_names": {"type": "array", "items": {"type": "string"}},
          "product_names": {"type": "array", "items": {"type": "string"}},
          "organizations": {"type": "array", "items": {"type": "string"}},
          "people": {"type": "array", "items": {"type": "string"}},
          "why_it_matters": {"type": "string"},
          "evidence": {"type": "string"},
          "evidence_start": {"type": "integer", "minimum": 0},
          "evidence_end": {"type": "integer", "minimum": 0},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1}
        }
      }
    },
    "concept_candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["candidate_concept", "surface_terms", "topic_family", "usefulness_reason", "evidence", "evidence_start", "evidence_end", "confidence"],
        "properties": {
          "candidate_concept": {"type": "string"},
          "surface_terms": {"type": "array", "items": {"type": "string"}},
          "topic_family": {"type": "string"},
          "usefulness_reason": {"type": "string"},
          "evidence": {"type": "string"},
          "evidence_start": {"type": "integer", "minimum": 0},
          "evidence_end": {"type": "integer", "minimum": 0},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1}
        }
      }
    },
    "rejected_candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["text", "reason"],
        "properties": {
          "text": {"type": "string"},
          "reason": {"type": "string"}
        }
      }
    },
    "no_signal_reason": {"type": ["string", "null"]},
    "overall_confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "needs_review": {"type": "boolean"},
    "review_reason": {"type": ["string", "null"]}
  }
}
